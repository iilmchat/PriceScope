# Скопируйте в .env (не коммитится). Все ключи имеют префикс PRICESCOPE_.
PRICESCOPE_MODE=local
PRICESCOPE_DB_PATH=data/pricescope.db
PRICESCOPE_HOST=127.0.0.1
PRICESCOPE_PORT=8775
PRICESCOPE_DEFAULT_LAT=55.3925
PRICESCOPE_DEFAULT_LON=36.7323

# Лента (опционально)
PRICESCOPE_LENTA_BRAND=lo
PRICESCOPE_LENTA_CHANNEL=lo

# Пятёрочка (только при установленном extras parser5ka)
# ВАЖНО: путь к camoufox.exe, а не к папке сборки!
CAMOUFOX_EXECUTABLE_PATH=C:\Users\Z1\AppData\Local\camoufox\camoufox-158.0.1-beta.41\camoufox.exe
